# 复制为 .env.local 后再填写；等号右侧只填写值，不要加 Bearer、反引号或 Markdown 代码块。
# Supabase 浏览器端配置：在 Project Settings → API Keys 中复制 Project URL 与 Publishable key。
NEXT_PUBLIC_SUPABASE_URL=https://你的项目ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_在这里粘贴Publishable_key

# 仅服务端使用：粘贴 Secret key（sb_secret_...），绝不能添加 NEXT_PUBLIC_ 前缀或提交到 Git。
SUPABASE_SECRET_KEY=sb_secret_在这里粘贴Secret_key

# 密钥请从 DeepSeek 平台的 API Keys 页面完整复制，例如：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 不要把真实密钥提交到 Git，也不要使用 NEXT_PUBLIC_ 前缀。
DEEPSEEK_API_KEY=sk-在这里粘贴你的完整DeepSeek_API_Key

# 使用 DeepSeek 当前 Chat Completions 接口支持的模型。
DEEPSEEK_MODEL=deepseek-v4-flash

# 官方 API 基础地址；不要在末尾添加 /chat/completions。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼（通义千问）OpenAI 兼容接口：在百炼控制台 → API-KEY 管理中获取
# 你的个人 token 计划密钥，同样只放服务端、不提交到 Git。
DASHSCOPE_API_KEY=sk-在这里粘贴你的百炼API_Key

# 使用百炼当前支持的模型（本项目的实际配置为 qwen3.7-plus）。
DASHSCOPE_MODEL=qwen3.7-plus

# 百炼 OpenAI 兼容模式的基础地址；不要在末尾添加 /chat/completions。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
