[Unit]
Description=Career Brief AI Resume Assistant (Next.js standalone)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ai-resume-assistant/app
EnvironmentFile=/srv/ai-resume-assistant/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
